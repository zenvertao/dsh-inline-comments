    ],
    "avoided": [
      "typert remotes",
      "internal store shapes"
    ],
    "legacy": [
      "ctx.conversation.input.shell() (kept for 0.1.x)"
    ]
  },
  "sessionIdResolvers": [
    "[data-conversation-session] (0.1.7+)",
